# The MVP deliberately uses paper trading only.
AEGIS_MODE=paper
INITIAL_CAPITAL=20
AEGIS_INITIAL_CAPITAL=20
AEGIS_CORS_ORIGINS=http://localhost:5173
AEGIS_ADMIN_TOKEN=replace-with-a-long-random-secret

# Focused mode: single strategy, reduced universe, position cap.
AEGIS_FOCUSED_MODE=true
AEGIS_FOCUSED_STRATEGY=donchian_breakout_long_flat
AEGIS_FOCUSED_SYMBOLS=PAXGUSDT,BTCUSDT,ETHUSDT
AEGIS_MAX_POSITIONS=3
AEGIS_DONCHIAN_BREAKOUT_PERIOD=20
AEGIS_DONCHIAN_EXIT_PERIOD=10
