# ============================================
# AEGIS AI — Variables d'environnement
# Copier ce fichier en .env et remplir les valeurs
# ============================================

# --- Mode ---
AEGIS_MODE=paper                      # paper | live
AEGIS_ADMIN_TOKEN=                    # Token d'administration
AEGIS_CORS_ORIGINS=http://localhost:5173
AEGIS_INITIAL_CAPITAL=20

# --- ICT/SMC Bot Configuration ---
AEGIS_ICT_CAPITAL=50                  # Capital de référence pour bot ICT/SMC (50€)
AEGIS_ICT_SYMBOLS=EURUSD,GBPUSD,XAUUSD  # Instruments Forex pour bot ICT/SMC
AEGIS_ICT_PRIMARY=EURUSD              # Instrument prioritaire pour tests

# --- API Server ---
AEGIS_API_HOST=0.0.0.0
AEGIS_API_PORT=8000
AEGIS_WEB_PORT=80

# --- Database ---
AEGIS_DB_PATH=./data/aegis.db

# --- Trading Limits ---
AEGIS_MAX_ORDER_NOTIONAL=500
AEGIS_MAX_TOTAL_EXPOSURE=2000

# --- Execution Defaults ---
AEGIS_DEFAULT_FEE_BPS=10
AEGIS_DEFAULT_SLIPPAGE_BPS=5
AEGIS_DEFAULT_CHUNKS=3
AEGIS_DEFAULT_DELAY_MS=500

# --- Timeouts ---
AEGIS_HTTP_TIMEOUT=15
AEGIS_AI_TIMEOUT=30
AEGIS_PROXY_TIMEOUT=300

# --- AI / OpenCode Zen (primary) ---
OPENCODE_API_KEY=
AEGIS_OPENCODE_MODEL=nemotron-3-ultra-free
AEGIS_OPENCODE_BASE_URL=https://opencode.ai/zen/v1
AEGIS_OPENCODE_TEMPERATURE=0.3
AEGIS_OPENCODE_MAX_TOKENS=2048

# --- AI / OpenRouter (fallback) ---
OPENROUTER_API_KEY=
AEGIS_OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
AEGIS_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AEGIS_OPENROUTER_TEMPERATURE=0.3
AEGIS_OPENROUTER_MAX_TOKENS=2048

# --- CCXT Exchange ---
AEGIS_CCXT_EXCHANGE_ID=binance
AEGIS_CCXT_TESTNET=true

# --- Binance (testnet keys) ---
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=
AEGIS_BINANCE_TESTNET_SPOT_URL=https://testnet.binance.vision/api
AEGIS_BINANCE_TESTNET_FUTURES_URL=https://testnet.binancefuture.com/fapi/v1
AEGIS_BINANCE_SPOT_URL=https://api.binance.com/api/v3
AEGIS_BINANCE_FUTURES_URL=https://fapi.binance.com/fapi/v1

# --- Finnhub (free tier: 60 req/min) ---
FINNHUB_API_KEY=                    # Get free key at https://finnhub.io/register

# --- Telegram (optional) ---
TELEGRAM_BOT_TOKEN=                 # Get from @BotFather
TELEGRAM_CHAT_ID=                   # Your chat ID (use @userinfobot)

# --- Free API URLs ---
AEGIS_COINGECKO_URL=https://api.coingecko.com/api/v3
AEGIS_DEFILLAMA_URL=https://api.llama.fi
AEGIS_DEFILLAMA_YIELDS_URL=https://yields.llama.fi
AEGIS_PERPFINDER_URL=https://api.perpfinder.com
AEGIS_MEMPOOL_URL=https://mempool.space/api
AEGIS_DEXSCREENER_URL=https://api.dexscreener.com
AEGIS_COINPAPRIKA_URL=https://api.coinpaprika.com
AEGIS_FRANKFURTER_URL=https://api.frankfurter.app
AEGIS_POLYMARKET_URL=https://gamma-api.polymarket.com
AEGIS_COINLORE_URL=https://api.coinlore.net
AEGIS_TERMINALFEED_URL=https://terminalfeed.io
AEGIS_BLOCKSTREAM_URL=https://blockstream.info/api
AEGIS_FEAR_GREED_URL=https://api.alternative.me/fng/?limit=1&format=json
AEGIS_FREE_API_WORKERS=6

# --- Multi-Asset ---
AEGIS_FOREX_API_URL=https://open.er-api.com/v6/latest
AEGIS_TWELVEDATA_URL=https://api.twelvedata.com
AEGIS_YAHOO_FINANCE_URL=https://query1.finance.yahoo.com/v8/finance/chart
AEGIS_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,BNBUSDT,XRPUSDT

# --- Alert Thresholds ---
AEGIS_ALERT_MAX_DRAWDOWN_PCT=15
AEGIS_ALERT_VAR_95_PCT=5
AEGIS_ALERT_RSI_OVERBOUGHT=75
AEGIS_ALERT_RSI_OVERSOLD=25
AEGIS_ALERT_VOLATILITY_SPIKE=0.05
AEGIS_ALERT_POSITION_LIMIT_PCT=80
AEGIS_ALERT_FUNDING_RATE_EXTREME=0.001

# --- Deployment Stage Thresholds ---
AEGIS_DEPLOY_BACKTEST_MIN_SHARPE=0.0
AEGIS_DEPLOY_BACKTEST_MIN_TRADES=5
AEGIS_DEPLOY_WF_MIN_SHARPE=0.3
AEGIS_DEPLOY_WF_MIN_TRADES=10
AEGIS_DEPLOY_WF_MAX_DRAWDOWN=-0.20
AEGIS_DEPLOY_PAPER_MIN_SHARPE=0.5
AEGIS_DEPLOY_PAPER_MIN_TRADES=20
AEGIS_DEPLOY_PAPER_MAX_DRAWDOWN=-0.15
AEGIS_DEPLOY_VALID_MIN_SHARPE=0.7
AEGIS_DEPLOY_VALID_MIN_TRADES=30
AEGIS_DEPLOY_VALID_MAX_DRAWDOWN=-0.12

# --- Backend DB ---
DATABASE_URL=sqlite:///./data/aegis.db

# --- Live Exchange Credentials ---
AEGIS_LIVE_API_KEY=
AEGIS_LIVE_API_SECRET=
AEGIS_LIVE_EXCHANGE_ID=binance
AEGIS_LIVE_TESTNET=true

# --- Engine ---
ENGINE_INTERVAL_PRICES=60
ENGINE_INTERVAL_ANALYSIS=300
ENGINE_INTERVAL_SIGNALS=600
ENGINE_INTERVAL_TRADES=600
ENGINE_INTERVAL_TRAILING_STOPS=10
ENGINE_INTERVAL_CIRCUIT_BREAKER=30
ENGINE_INTERVAL_POSITIONS=15
ENGINE_INTERVAL_LEARNING=3600
