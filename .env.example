# ============================================================
# AEGIS AI Quant — Environment Variables for Deployment
# ============================================================
# Copy to .env and fill in your values

# --- Mode ---
AEGIS_MODE=paper
AEGIS_ADMIN_TOKEN=your-admin-token-here
AEGIS_CORS_ORIGINS=http://localhost:5173,https://your-frontend.vercel.app

# --- Engine (set false on serverless/Vercel; true on Fly.io) ---
AEGIS_ENGINE_ENABLED=true
AEGIS_DB_PATH=backend/data/aegis.db

# --- Supabase (optional — storage_supabase.py is not wired yet; SQLite is used) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key

# --- Trading ---
AEGIS_FOCUSED_MODE=true
AEGIS_FOCUSED_STRATEGY=donchian_breakout_long_flat
AEGIS_FOCUSED_SYMBOLS=PAXGUSDT,BTCUSDT,ETHUSDT
AEGIS_MAX_POSITIONS=3
AEGIS_DONCHIAN_BREAKOUT_PERIOD=20
AEGIS_DONCHIAN_EXIT_PERIOD=10
AEGIS_INITIAL_CAPITAL=20
AEGIS_ICT_CAPITAL=50

# --- Exchange (optional — for live/testnet) ---
# BINANCE_TESTNET_API_KEY=
# BINANCE_TESTNET_API_SECRET=
# AEGIS_CCXT_TESTNET=true

# --- AI (optional) ---
# OPENCODE_API_KEY=
# OPENROUTER_API_KEY=
# FINNHUB_API_KEY=

# --- Telegram (optional) ---
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# --- Frontend ---
# VITE_API_URL must point at the FastAPI backend, NOT the frontend.
# NEVER add VITE_ADMIN_TOKEN: Vite inlines VITE_* variables into the public
# JS bundle, which would publish the admin token to every visitor. The token
# is typed in the dashboard login screen and kept in the browser only.
#
# For local work use the local backend, and keep the default backend port in
# sync with AEGIS_API_PORT above (8000):
#     VITE_API_URL=http://localhost:8000
#
# Do not leave the deployed URL here while developing. Every financial endpoint
# is authenticated with the single admin token typed into the browser, so a dev
# server pointed at the deployment signs in to the real account and its order,
# emergency-stop and mode endpoints act on it. The dev build refuses to start
# against a remote host unless VITE_ALLOW_REMOTE_API=1 is set deliberately, so
# pointing dev at a staging machine is possible but never accidental.
#     VITE_API_URL=https://your-backend.fly.dev   # build/deploy
#     VITE_ALLOW_REMOTE_API=1                     # only for intentional staging
VITE_API_URL=http://localhost:8000

# --- API documentation ---
# /docs, /redoc and /openapi.json are not served unless this is set. They publish
# the full endpoint map, admin routes included, and they are FastAPI built-ins, so
# the route auth inventory cannot classify them. Off by default.
# The contract is still available without any public route:
#     python -m app.export_openapi openapi.json
# AEGIS_EXPOSE_API_DOCS=1

