# ============================================================
# AEGIS AI Quant — Environment Variables for Deployment
# ============================================================
# Copy to .env and fill in your values

# --- Mode ---
AEGIS_MODE=paper
AEGIS_ADMIN_TOKEN=your-admin-token-here

# --- Supabase (required for cloud deployment) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key

# --- Trading ---
AEGIS_FOCUSED_MODE=true
AEGIS_FOCUSED_SYMBOLS=PAXGUSDT,BTCUSDT,ETHUSDT
AEGIS_MAX_POSITIONS=3
AEGIS_INITIAL_CAPITAL=20
AEGIS_ICT_CAPITAL=50

# --- Exchange (optional — for live/testnet) ---
# BINANCE_TESTNET_API_KEY=
# BINANCE_TESTNET_API_SECRET=
# AEGIS_CCXT_TESTNET=true

# --- AI (optional) ---
# OPENCODE_API_KEY=
# OPENROUTER_API_KEY=

# --- Telegram (optional) ---
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# --- Frontend ---
VITE_API_URL=https://your-app.vercel.app
VITE_ADMIN_TOKEN=your-admin-token-here
